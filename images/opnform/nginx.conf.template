# Rendered at start-up by opnform-railway-entrypoint (@PLACEHOLDERS@ replaced). Mirrors upstream docker/nginx.conf.
worker_processes auto;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
    client_max_body_size @MAX_BODY@;

    log_format opnform '$remote_addr "$request_method $uri" $status $body_bytes_sent $request_time';
    access_log /dev/stdout opnform;

    # The client host is resolved per request (valid=10s), so a redeployed client is found again.
    resolver @RESOLVER@ valid=10s;

    # Requests reach nginx through Railway's edge (or a local proxy). Take the client IP from X-Forwarded-For,
    # trusting only private/loopback hops, so Laravel's per-IP rate limits see real clients.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from fc00::/7;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    map $request_uri $api_uri {
        ~^/api(/.*$) $1;
        default $request_uri;
    }
    map $http_x_forwarded_proto $fwd_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }
    map $fwd_proto $fwd_https {
        https on;
        default "";
    }
    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" "";
    }

    server {
        listen [::]:@PORT@ ipv6only=off;
        server_name _;
        root /usr/share/nginx/html/public;
        index index.php;

        location / {
            set $opnform_client "@CLIENT_UPSTREAM@";
            proxy_http_version 1.1;
            proxy_pass http://$opnform_client;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location ~ /(api|open|local\/temp|forms\/assets)/ {
            try_files $uri $uri/ /index.php$is_args$args;
        }

        location ~ \.php$ {
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root/index.php;
            fastcgi_param REQUEST_URI $api_uri;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param HTTPS $fwd_https;
            fastcgi_param HTTP_X_FORWARDED_FOR "";
            fastcgi_param HTTP_X_FORWARDED_HOST "";
            fastcgi_param HTTP_X_FORWARDED_PORT "";
            fastcgi_param HTTP_X_FORWARDED_PROTO "";
            fastcgi_read_timeout 600s;
        }

        location ~ /\. {
            deny all;
        }
    }
}
